local.file_match "logs" {
  path_targets = [
    {"__path__" = "/var/lib/docker/containers/*/*.log"},
  ]
}

loki.source.file "containers" {
  targets    = local.file_match.logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    name = "loki"
    url  = "http://loki:3100/loki/api/v1/push"
  }
}
